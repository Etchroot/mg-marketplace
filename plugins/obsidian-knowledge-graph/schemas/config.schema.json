{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "number",
      "const": 1
    },
    "vault_path": {
      "type": "string",
      "minLength": 1
    },
    "allowed_input_roots": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "git": {
      "default": {
        "enabled": false,
        "remote": "origin",
        "branch": "main",
        "push_on_capture": true
      },
      "type": "object",
      "properties": {
        "enabled": {
          "default": false,
          "type": "boolean"
        },
        "remote": {
          "default": "origin",
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "branch": {
          "default": "main",
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9/_-]*$"
        },
        "push_on_capture": {
          "default": true,
          "type": "boolean"
        }
      },
      "required": [
        "enabled",
        "remote",
        "branch",
        "push_on_capture"
      ],
      "additionalProperties": false
    },
    "notion": {
      "default": {
        "enabled": false
      },
      "type": "object",
      "properties": {
        "enabled": {
          "default": false,
          "type": "boolean",
          "const": false
        },
        "parent_page_id": {
          "type": "null"
        },
        "credential_ref": {
          "type": "null"
        }
      },
      "required": [
        "enabled"
      ],
      "additionalProperties": false
    },
    "runtime_path": {
      "type": "string"
    },
    "search": {
      "type": "object",
      "properties": {
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "default_hops": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2
        },
        "max_hops": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 2
        },
        "max_nodes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        }
      },
      "required": [
        "limit",
        "default_hops",
        "max_hops",
        "max_nodes"
      ],
      "additionalProperties": false
    },
    "read": {
      "type": "object",
      "properties": {
        "default_chars": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8000
        },
        "max_chars": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8000
        }
      },
      "required": [
        "default_chars",
        "max_chars"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "vault_path",
    "allowed_input_roots",
    "git",
    "notion"
  ],
  "additionalProperties": false
}
