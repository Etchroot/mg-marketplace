{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "terms": {
      "minItems": 1,
      "maxItems": 10,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 2,
        "maxLength": 200
      }
    },
    "record_types": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "essay",
          "journal",
          "company_research",
          "work",
          "project",
          "experience",
          "reference",
          "other"
        ]
      }
    },
    "document_status": {
      "type": "string",
      "enum": [
        "draft",
        "final",
        "submitted"
      ]
    },
    "date_from": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "date_to": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "versions": {
      "type": "string",
      "enum": [
        "latest",
        "all"
      ]
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "cursor": {
      "type": "string",
      "maxLength": 2000
    },
    "fallback": {
      "type": "string",
      "enum": [
        "none",
        "raw_text"
      ]
    }
  },
  "required": [
    "terms"
  ],
  "additionalProperties": false
}
