{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "seed_ids": {
      "minItems": 1,
      "maxItems": 5,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "hops": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2
    },
    "max_nodes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20
    }
  },
  "required": [
    "seed_ids"
  ],
  "additionalProperties": false
}
